digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.6", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="pe_group_controller: actual FSM (shared)"];
 node [shape=box, style="rounded,filled", fillcolor="#e8f1fc", color="#35577a", fontname="DejaVu Sans", fontsize=12, margin="0.13,0.09"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#526578", arrowsize=0.7];

 IDLE [label="IDLE"];
 CLEAR [label="CLEAR\npe_clear=1; reset issue_count"];
 REPLAY [label="REPLAY\nreplay_valid=1"];
 RUN [label="RUN\naccept activation/read requests\nand consume completed operands"];
 WAIT_LAST [label="WAIT_LAST\nno new activation\ncontinue consuming operands"];
 DRAIN_MAC [label="DRAIN_MAC\nfinal product commits into ACC"];
 START_RESULT [label="START_RESULT\nresult_start_valid=1"];
 WAIT_RESULT [label="WAIT_RESULT\nACC stays stable"];
 NEXT_GROUP [label="NEXT_GROUP\nchannel_base+=12\nweight_base+=K; remaining-=12"];
 IDLE -> CLEAR [label="valid command fire"];
 IDLE -> IDLE [label="invalid command: error pulse\nor no command"];
 CLEAR -> REPLAY [label="next edge"];
 REPLAY -> REPLAY [label="!replay_ready"];
 REPLAY -> RUN [label="replay handshake"];
 RUN -> RUN [label="non-final issue: issue_count++\nor no issue: hold"];
 RUN -> WAIT_LAST [label="Kth activation/read issued"];
 WAIT_LAST -> WAIT_LAST [label="last operand not consumed"];
 WAIT_LAST -> DRAIN_MAC [label="pe_accumulate_en && align_out_last"];
 DRAIN_MAC -> START_RESULT [label="next edge"];
 START_RESULT -> WAIT_RESULT [label="result_start handshake"];
 WAIT_RESULT -> NEXT_GROUP [label="group_result_done && remaining>12"];
 NEXT_GROUP -> CLEAR [label="next edge"];
 WAIT_RESULT -> IDLE [label="group_result_done && remaining<=12\ncore_done pulse"];

}
